src-tauri/.probe-*.json

# wrangler 本地跑的产物：.wrangler 是 KV 的本地模拟与缓存，.dev.vars 是本地密钥
# （真机部署走控制台/`wrangler secret put`，这两样都不该进仓库）
.wrangler/
.dev.vars

# 名单的本地工作副本：`/submit` 拉下来改完再推的那一份，以及推之前的留档
# （内容是贡献者昵称，且真源在线上 KV，没必要进仓库历史）
deploy/ack/contributors.local.json
deploy/ack/contributors.prev.json

