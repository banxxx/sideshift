{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SideShift",
  "mainBinaryName": "SideShift",
  "version": "../package.json",
  "identifier": "com.poso.sideshift",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SideShift",
        "width": 1200,
        "height": 800,
        "minWidth": 1120,
        "minHeight": 700,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
