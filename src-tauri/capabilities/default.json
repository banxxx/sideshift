{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. opener 两条必须配对：allow-open-url 只放开命令，allow-default-urls 才给出 URL 白名单（mailto/tel/http/https）；缺后者 openUrl 一律 ForbiddenUrl",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-is-maximized",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://api.modrinth.com/**" },
        { "url": "https://api.curseforge.com/**" },
        { "url": "https://mediafilez.forgecdn.net/**" },
        { "url": "https://cdn.modrinth.com/**" },
        { "url": "https://maven.minecraftforge.net/**" },
        { "url": "https://maven.fabricmc.net/**" }
      ]
    }
  ]
}
